# Decompiled game and dependency reference material stays local.
/inspection/
**/bin/
**/obj/
**/config-tests/
/test-results*.txt
# Keep only the current distributable in the backup.
/ActFloorCustomizer-*.zip
/releases/*.zip
!/releases/ActFloorCustomizer-v0.8.3-sts2-v0.113.1.zip
# Also ignore the mod's runtime diagnostic log.
ActFloorCustomizer-diag.log
# Third-party uploader binaries stay out of the repository.
/workshop/ModUploader.exe
/workshop/ModUploader.pdb
/workshop/steam_api64.dll
/workshop/steam_appid.txt
/workshop/mod-uploader.log
.vs/
.idea/
*.user
*.suo
*.pdb
.git-commit-msg.tmp
